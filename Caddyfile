{
	servers {
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}

{$CADDY_SITE_ADDRESS} {
	log {
		output stdout
		format console
	}

	request_body {
		max_size 1MB
	}

	# Limit every client request, including unknown paths probed by bots. A normal
	# viewer polls the aircraft API 30 times per minute, so 90 requests per minute
	# leaves room for initial page assets, retries, and occasional extra viewing.
	# Group IPv6 privacy addresses by /64 so changing addresses cannot evade the
	# limit.
	# This service is intended for direct human use, not cloud-hosted clients.
	defender block {
		ranges aws azurepubliccloud deepseek gcloud githubcopilot openai
	}

	rate_limit {
		zone site_requests {
			key {remote_host}
			events 90
			window 1m
			ipv6_prefix 64
		}
	}

	reverse_proxy app:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 30s
			write_timeout 30s
		}
	}
}
