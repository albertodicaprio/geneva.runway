{
	# Defender must label matching requests before caddy-ratelimit evaluates them.
	order defender before rate_limit

	servers {
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}

{$CADDY_SITE_ADDRESS} {
	log {
		output stdout
		format console
	}

	request_body {
		max_size 1MB
	}

	# All aircraft API clients are limited independently. Group IPv6 privacy
	# addresses by /64 so changing addresses cannot evade the limit.
	defender ratelimit {
		ranges aws azurepubliccloud deepseek gcloud githubcopilot openai
	}

	rate_limit {
		zone aircraft_api {
			match {
				path /api/aircraft
			}
			key {remote_host}
			events 30
			window 1m
			ipv6_prefix 64
		}

		# Automated-cloud ranges marked by Defender get a lower allowance.
		zone automated_aircraft_api {
			match {
				path /api/aircraft
				header X-RateLimit-Apply true
			}
			key {remote_host}
			events 10
			window 1m
			ipv6_prefix 64
		}
	}

	reverse_proxy app:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 30s
			write_timeout 30s
		}
	}
}
