{
	servers {
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}

gva-runway.duckdns.org {
	request_body {
		max_size 1MB
	}

	reverse_proxy app:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 30s
			write_timeout 30s
		}
	}
}
