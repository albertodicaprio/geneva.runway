{
	servers {
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 2m
		}
	}
}

{$CADDY_SITE_ADDRESS} {
	log {
		output stdout
		format console
	}

	request_body {
		max_size 1MB
	}

	# Give page navigation and assets room for rapid reloads, while keeping the
	# aircraft API at its existing per-client rate. Unknown paths still count
	# toward the site limit. Group IPv6 privacy addresses by /64.
	# This service is intended for direct human use, not cloud-hosted clients.
	defender block {
		ranges aws azurepubliccloud deepseek gcloud githubcopilot openai
	}

	rate_limit {
		zone site_requests {
			key {remote_host}
			events 120
			window 15s
			ipv6_prefix 64
		}
		zone aircraft_requests {
			match {
				path /api/aircraft
			}
			key {remote_host}
			events 24
			window 15s
			ipv6_prefix 64
		}
	}

	reverse_proxy app:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 30s
			write_timeout 30s
		}
	}
}
