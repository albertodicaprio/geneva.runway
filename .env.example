# Google sign-in (optional). Copy these settings into your existing .env.
# Keep credentials blank to leave sign-in disabled; the dashboard stays public.
# Website address only; do not include /auth/google/callback here.
APP_ORIGIN=https://gva-runway.ahpc.ch
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact authorized redirect URI in your Google web OAuth client:
# https://gva-runway.ahpc.ch/auth/google/callback
# For local Node development, use APP_ORIGIN=http://127.0.0.1:3000
# and register http://127.0.0.1:3000/auth/google/callback too.
# For local Compose through Caddy use APP_ORIGIN=http://127.0.0.1
# and register http://127.0.0.1/auth/google/callback.

# Optional local settings file override (default: data/user-settings.json).
# Compose stores settings at /app/data/user-settings.json in its data volume.
# USER_SETTINGS_FILE=/path/to/user-settings.json

# Auth analytics uses the same UMAMI_WEBSITE_ID as the browser tracker.
# Compose sends events directly to http://umami:3000/api/send automatically.
# For npm start, optionally set the reachable local Umami collection URL:
# UMAMI_AUTH_EVENTS_URL=http://192.168.0.184:3001/api/send
# Trust forwarded IP headers only behind your controlled Caddy proxy.
# Compose sets this to true; direct local Node development defaults to false.
# UMAMI_AUTH_EVENTS_TRUST_PROXY=false
