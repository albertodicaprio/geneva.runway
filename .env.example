# Google sign-in (optional). Copy these settings into your existing .env.
# Keep credentials blank to leave sign-in disabled; the dashboard stays public.
# Website address only; do not include /auth/google/callback here.
APP_ORIGIN=https://gva-runway.ahpc.ch
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact authorized redirect URI in your Google web OAuth client:
# https://gva-runway.ahpc.ch/auth/google/callback
# For local Node development, use APP_ORIGIN=http://127.0.0.1:3000
# and register http://127.0.0.1:3000/auth/google/callback too.
# For local Compose through Caddy use APP_ORIGIN=http://127.0.0.1
# and register http://127.0.0.1/auth/google/callback.

# Optional local settings file override (default: data/user-settings.json).
# Compose stores settings at /app/data/user-settings.json in its data volume.
# USER_SETTINGS_FILE=/path/to/user-settings.json

# Auth analytics uses the same UMAMI_WEBSITE_ID as the browser tracker.
# Compose sends events directly to http://umami:3000/api/send automatically.
# For npm start, optionally set the reachable local Umami collection URL:
# UMAMI_AUTH_EVENTS_URL=http://192.168.0.184:3001/api/send
# Trust forwarded IP headers only behind your controlled Caddy proxy.
# Compose sets this to true; direct local Node development defaults to false.
# UMAMI_AUTH_EVENTS_TRUST_PROXY=false

# Telegram integration (optional; leave both blank to disable).
# 1. In Telegram open the verified @BotFather account and use /newbot.
#    Choose a name and a unique username ending in "bot". No commands or
#    Telegram login/domain settings are required; disable joining groups with
#    BotFather's /setjoingroups because this app connects private chats only.
# 2. Copy the API token here; never commit it or paste it into a browser URL.
TELEGRAM_BOT_TOKEN=
# Username from BotFather, without @ (for example GenevaRunwayAlertsBot).
TELEGRAM_BOT_USERNAME=
# 3. Start the app (npm start or docker compose up -d --build app caddy).
#    The server checks the bot identity and starts outbound long polling.
#    No public URL, webhook secret, tunnel or registration script is required.
#    Local Google sign-in still needs APP_ORIGIN and its Google redirect URI
#    as described above. Sign in, open Telegram Integration, click Connect,
#    open the link or scan the QR code, and press Start in Telegram.
#    Use separate bots for development and production. Only one running app
#    instance may poll each bot: stop local Node before using the same bot in
#    local Compose. Notifications and linking work on localhost HTTP.
# Optional file override (default: data/telegram-connections.json).
# Saved connections and the polling cursor share this file; Compose stores it
# at /app/data/telegram-connections.json in its persistent data volume.
# TELEGRAM_CONNECTIONS_FILE=/path/to/telegram-connections.json
